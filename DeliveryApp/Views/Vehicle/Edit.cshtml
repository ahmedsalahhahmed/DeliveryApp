@model DeliveryApp.Models.Vehicle
@{
    ViewData["Title"] = "Edit Vehicle";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-body">
                    <h2 class="card-title text-center mb-4">Update Your Vehicle</h2>
                    <p class="text-muted text-center">Changes will take effect immediately.</p>
                    <hr />

                    <form asp-action="Edit" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        <input type="hidden" asp-for="Id" />

                        <div class="mb-3">
                            <label asp-for="Make" class="control-label fw-bold">Manufacturer</label>
                            <select asp-for="Make" class="form-select" id="carMakeSearch">
                                <option value="">-- Search Make --</option>
                                @foreach (var make in ViewBag.CarMakes)
                                {
                                    <option value="@make">@make</option>
                                }
                            </select>
                            <span asp-validation-for="Make" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Model" class="control-label fw-bold">Car Model</label>
                            <input asp-for="Model" class="form-control" placeholder="e.g., Corolla, Elantra" />
                            <span asp-validation-for="Model" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Color" class="control-label fw-bold">Color</label>
                            <input asp-for="Color" class="form-control" placeholder="e.g., Silver, Black" />
                            <span asp-validation-for="Color" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="LicensePlate" class="control-label fw-bold">License Plate Number</label>

                            <input asp-for="LicensePlate" class="form-control fw-bold text-uppercase"
                                   placeholder="ABC 1234"
                                   pattern="^[a-zA-Z\s\-]{2,8}[0-9]{3,4}$"
                                   title="2-3 English letters followed by 3-4 numbers" />

                            <div class="form-text">Example: ABC 1234 (English letters and numbers only)</div>
                            <span asp-validation-for="LicensePlate" class="text-danger"></span>
                        </div>

                        <button type="submit" class="btn btn-primary btn-lg w-100 mt-3">Save Updates</button>
                        <a asp-controller="Ride" asp-action="Index" class="btn btn-outline-secondary w-100 mt-2">Cancel</a>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    <script>
        $(document).ready(function () {
            $('#carMakeSearch').select2({
                placeholder: "-- Search Make --",
                allowClear: true,
                width: '100%'
            });
        });
    </script>
}