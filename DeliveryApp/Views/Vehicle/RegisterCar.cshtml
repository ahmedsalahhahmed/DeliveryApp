@model DeliveryApp.Models.Vehicle

@{
    ViewData["Title"] = "Register Vehicle";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-body">
                    <h2 class="card-title text-center mb-4">Register Your Vehicle</h2>
                    <p class="text-muted text-center">Drivers must register their vehicle before accepting rides.</p>
                    <hr />

                    <form asp-action="RegisterCar" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <div class="mb-3">
                            <label asp-for="Make" class="control-label fw-bold">Car Make</label>
                            <input asp-for="Make" class="form-control" placeholder="e.g., Toyota, Honda" />
                            <span asp-validation-for="Make" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Model" class="control-label fw-bold">Car Model</label>
                            <input asp-for="Model" class="form-control" placeholder="e.g., Camry, Civic" />
                            <span asp-validation-for="Model" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Color" class="control-label fw-bold">Color</label>
                            <input asp-for="Color" class="form-control" placeholder="e.g., Silver, Black" />
                            <span asp-validation-for="Color" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="LicensePlate" class="control-label fw-bold">License Plate Number</label>
                            <input asp-for="LicensePlate" class="form-control text-uppercase" placeholder="ABC-1234" />
                            <span asp-validation-for="LicensePlate" class="text-danger"></span>
                        </div>

                        <button type="submit" class="btn btn-primary btn-lg w-100 mt-3">Register Car</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}