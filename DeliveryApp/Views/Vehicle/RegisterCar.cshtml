@model DeliveryApp.Models.Vehicle

@{
    ViewData["Title"] = "Register Vehicle";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-body">
                    <h2 class="card-title text-center mb-4">Register Your Vehicle</h2>
                    <p class="text-muted text-center">Drivers must register their vehicle before accepting rides.</p>
                    <hr />

                    <form asp-action="RegisterCar" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <div class="mb-3">
                            <label asp-for="Make" class="control-label fw-bold"> Manufacturer </label>

                            <select asp-for="Make" class="form-select" id="carMakeSearch">
                                <option value="">-- Search Make --</option>

                                @foreach (var make in ViewBag.CarMakes)
                                {
                                    <option value="@make">@make</option>
                                }
                            </select>

                            <span asp-validation-for="Make" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Model" class="control-label fw-bold">Car Model</label>
                            <input asp-for="Model" class="form-control" placeholder="e.g., Corolla, Elantra" />
                            <span asp-validation-for="Model" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Color" class="control-label fw-bold">Color</label>
                            <input asp-for="Color" class="form-control" placeholder="e.g., Silver, Black" />
                            <span asp-validation-for="Color" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="LicensePlate" class="control-label fw-bold">License Plate Number</label>
                            <input asp-for="LicensePlate" class="form-control fw-bold"
                                   placeholder="أ ب ج 1234 or ABC 123"
                                   pattern="^[\u0600-\u06FFa-zA-Z\s\-]{2,8}[0-9\u0660-\u0669]{3,4}$"
                                   title="2-3 letters followed by 3-4 numbers" />
                            <div class="form-text">Example: أ ب ج 1234 or ABC 123</div>
                            <span asp-validation-for="LicensePlate" class="text-danger"></span>
                        </div>

                        <button type="submit" class="btn btn-primary btn-lg w-100 mt-3">Register Car</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />

    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    <script>
        $(document).ready(function() {
            $('#carMakeSearch').select2({
                placeholder: "-- Search Make --",
                allowClear: true,
                width: '100%', // Ensures it matches Bootstrap's sizing
                dir: "rtl" // Set to "rtl" if your page is mostly Arabic, or "ltr" for English
            });
        });
    </script>
}