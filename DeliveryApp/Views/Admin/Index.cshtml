@model IEnumerable<DeliveryApp.Models.Ride>
@{
    ViewData["Title"] = "Admin Control Panel";
}

<div class="container mt-5">
    <h1 class="text-danger fw-bold">Admin Control Panel</h1>
    <hr />

    <div class="row text-center mt-4 mb-5">
        <div class="col-md-4 mb-3">
            <div class="card shadow border-primary h-100">
                <div class="card-body d-flex flex-column justify-content-center">
                    <h3>👥 Total Users</h3>
                    <h2 class="text-primary fw-bold">@ViewBag.TotalUsers</h2>
                    <div class="mt-auto">
                        <a asp-action="AllUsers" class="btn btn-primary mt-2 w-75 fw-bold">Manage Users</a>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-3">
            <div class="card shadow border-success h-100">
                <div class="card-body d-flex flex-column justify-content-center">
                    <h3>🚗 Total Rides</h3>
                    <h2 class="text-success fw-bold">@ViewBag.TotalRides</h2>
                    <div class="mt-auto">
                        <a asp-action="AllRides" class="btn btn-success mt-2 w-75 fw-bold">View All Rides</a>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-3">
            <div class="card shadow border-dark h-100">
                <div class="card-body d-flex flex-column justify-content-center">
                    <h3>💰 Total Platform Value</h3>
                    <h2 class="text-dark fw-bold">$@ViewBag.TotalRevenue.ToString("0.00")</h2>
                </div>
            </div>
        </div>
    </div>

    <h3 class="text-dark fw-bold mb-3 mt-4">⭐ Quality Control & Ratings</h3>
    <div class="row">

        <div class="col-md-4 mb-4">
            <div class="card shadow-sm border-warning h-100">
                <div class="card-header bg-warning text-dark fw-bold fs-5">🏆 Driver Leaderboard</div>
                <ul class="list-group list-group-flush">
                    @if (ViewBag.DriverStats.Count == 0)
                    {
                        <li class="list-group-item text-muted text-center p-4">No ratings yet.</li>
                    }
                    @foreach (var stat in ViewBag.DriverStats)
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center">

                            <div>
                                <strong class="text-dark">@stat.DriverName</strong><br />
                                <small class="text-muted">@stat.CarModel</small>
                            </div>

                            <span>
                                <span class="badge bg-warning text-dark rounded-pill shadow-sm">⭐ @stat.AverageRating.ToString("0.0")</span>
                                <small class="text-muted ms-1">(@stat.TotalTrips)</small>
                            </span>
                        </li>
                    }
                </ul>
            </div>
        </div>

        <div class="col-md-8 mb-4">
            <div class="card shadow-sm border-dark h-100">
                <div class="card-header bg-dark text-white fw-bold fs-5">Recent Ride Reviews</div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-striped table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Driver</th>
                                    <th>Passenger</th>
                                    <th class="text-center">Rating</th>
                                    <th>Comment</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!Model.Any())
                                {
                                    <tr>
                                        <td colspan="4" class="text-center text-muted p-4">No reviews have been submitted yet.</td>
                                    </tr>
                                }
                                @foreach (var ride in Model)
                                {
                                    <tr>
                                        <td class="fw-bold text-success">@ride.Driver?.Name</td>
                                        <td>@ride.Passenger?.Name</td>
                                        <td class="text-center"><span class="badge bg-warning text-dark px-2 py-1 shadow-sm fs-6">@ride.DriverRating ⭐</span></td>
                                        <td class="fst-italic text-muted">
                                            "@(string.IsNullOrEmpty(ride.DriverReview) ? "No comment left" : ride.DriverReview)"
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>