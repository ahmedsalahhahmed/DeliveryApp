@model IEnumerable<DeliveryApp.Models.Ride>
@{
    ViewData["Title"] = "All Rides";
}

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="fw-bold">🚗 All Platform Rides</h2>
        <a asp-action="Index" class="btn btn-outline-secondary">← Back to Dashboard</a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="table-responsive">
        <table class="table table-striped table-bordered table-hover align-middle mt-3">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Type</th>
                    <th>Passenger</th>
                    <th>Driver</th>
                    <th>Route</th>
                    <th>Status</th>
                    <th>Price</th>
                    <th>Rating</th>
                    <th>Comment</th>
                    <th class="text-center">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    @* Determine badge colour from status *@
                    string badgeClass = item.Status switch
                    {
                        "Completed" => "bg-success",
                        "Cancelled" => "bg-danger",
                        "Driver Assigned" => "bg-primary",
                        _ => "bg-secondary"   // "Requested"
                    };

                    @* Delivery type pill *@
                    string typeBadge = item.DeliveryType == "Package" ? "bg-info text-dark" : "bg-light text-dark border";
                    string typeIcon = item.DeliveryType == "Package" ? "📦" : "🧑";

                    bool canCancel = item.Status != "Completed" && item.Status != "Cancelled";

                    <tr>
                        <td class="fw-bold text-muted">#@item.Id</td>
                        <td><span class="badge @typeBadge">@typeIcon @item.DeliveryType</span></td>
                        <td>@item.Passenger?.Name</td>
                        <td>@(item.Driver != null ? item.Driver.Name : "<span class='text-muted'>Unassigned</span>")</td>
                        <td>
                            <small>
                                <span class="text-success fw-semibold">@item.PickupAddress</span>
                                <span class="text-muted mx-1">→</span>
                                <span class="text-danger fw-semibold">@item.DestinationAddress</span>
                            </small>
                        </td>
                        <td><span class="badge @badgeClass">@item.Status</span></td>
                        <td class="fw-bold">$@item.Price.ToString("0.00")</td>
                        <td>
                            @if (item.DriverRating != null)
                            {
                                <span class="text-warning fw-bold">@item.DriverRating ⭐</span>
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>
                        <td>
                            @if (!string.IsNullOrEmpty(item.DriverReview))
                            {
                                <span class="fst-italic text-muted">"@item.DriverReview"</span>
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>
                        <td class="text-center">
                            @if (canCancel)
                            {
                                <form asp-action="CancelRide" method="post" class="d-inline"
                                      onsubmit="return confirm('Cancel Ride #@item.Id? This cannot be undone.');">
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                        ✕ Cancel
                                    </button>
                                </form>
                            }
                            else
                            {
                                <span class="text-muted small">—</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>