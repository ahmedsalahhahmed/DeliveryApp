@model IEnumerable<DeliveryApp.Models.Ride>
@{
    ViewData["Title"] = "All Rides";
}

<div class="container mt-5">
    <h2>All Platform Rides</h2>
    <table class="table table-striped table-bordered mt-3">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Passenger</th>
                <th>Driver</th>
                <th>Route</th>
                <th>Status</th>
                <th>Price</th>
                <th>Rating</th>
                <th>Comment</th>

            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>#@item.Id</td>
                    <td>@item.Passenger?.Name</td>
                    <td>@(item.Driver != null ? item.Driver.Name : "Unassigned")</td>
                    <td>@item.PickupAddress -> @item.DestinationAddress</td>
                    <td><span class="badge bg-warning text-dark">@item.Status</span></td>
                    <td>$@item.Price.ToString("0.00")</td>

                    <td>
                        @if (item.DriverRating != null)
                        {
                            <span class="text-warning fw-bold">@item.DriverRating ⭐</span>
                        }
                        else
                        {
                            <span class="text-muted">-</span>
                        }
                    </td>
                    <td>
                        @if (!string.IsNullOrEmpty(item.DriverReview))
                        {
                            <span class="text-muted">@item.DriverReview</span>
                        }
                        else
                        {
                            <span class="text-muted">No comment left</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>