@model DeliveryApp.Models.Ride

@{
    ViewData["Title"] = "Request a Ride or Delivery";
}

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
<link rel="stylesheet" href="https://unpkg.com/leaflet-routing-machine@latest/dist/leaflet-routing-machine.css" />

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-10">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h3 class="card-title mb-0">Where to?</h3>
                </div>
                <div class="card-body">
                    <form asp-action="RequestRide" method="post">

                        <div class="mb-4">
                            <label asp-for="DeliveryType" class="form-label fw-bold">Service Type</label>
                            <select asp-for="DeliveryType" class="form-select form-select-lg" id="deliveryTypeSelect">
                                <option value="Passenger">🚗 I need a ride (Passenger)</option>
                                <option value="Package">📦 I need to send a Package</option>
                            </select>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-bold text-primary">📍 Tap the map to select Pickup, then tap again for Destination</label>
                            <div id="map" style="height: 400px; width: 100%; border-radius: 8px; border: 2px solid #ddd;" class="shadow-sm"></div>
                            <div class="mt-2 text-muted small" id="distanceDisplay"></div>
                            <button type="button" class="btn btn-sm btn-outline-danger mt-2" id="resetMapBtn" style="display:none;">Reset Pins</button>
                        </div>

                        <div class="row mb-4">
                            <div class="col-md-6">
                                <input type="hidden" asp-for="DistanceKm" id="DistanceKm" />
                                <label asp-for="PickupAddress" class="form-label fw-bold">Pickup Address</label>
                                <input asp-for="PickupAddress" class="form-control" id="PickupAddress" placeholder="Tap the map or type here..." required />
                            </div>
                            <div class="col-md-6">
                                <label asp-for="DestinationAddress" class="form-label fw-bold">Destination Address</label>
                                <input asp-for="DestinationAddress" class="form-control" id="DestinationAddress" placeholder="Tap the map or type here..." required />
                            </div>
                        </div>

                        <div id="packageDetailsSection" class="p-4 bg-light border rounded mb-4" style="display: none;">
                            <h5 class="fw-bold mb-3">Package Details (Used for Pricing)</h5>
                            <div class="mb-3">
                                <label asp-for="PackageDescription" class="form-label">What are you sending?</label>
                                <input asp-for="PackageDescription" class="form-control" placeholder="e.g., A box of books" />
                            </div>
                            <div class="row">
                                <div class="col-md-3">
                                    <label asp-for="EstimatedWeightKg" class="form-label">Weight (kg)</label>

                                    <input asp-for="EstimatedWeightKg" type="number" step="0.1" min="0.1" max="20" class="form-control" placeholder="0.0" />

                                    <small class="text-muted fw-bold">Max 20 kg</small>
                                    <span asp-validation-for="EstimatedWeightKg" class="text-danger small d-block"></span>
                                </div>
                                <div class="col-md-3">
                                    <label asp-for="LengthCm" class="form-label">Length (cm)</label>
                                    <input asp-for="LengthCm" type="number" step="0.1" min="1" max="50" class="form-control" placeholder="0.0" />
                                    <small class="text-muted fw-bold">Max 50 cm</small>
                                    <span asp-validation-for="LengthCm" class="text-danger small d-block"></span>
                                </div>
                                <div class="col-md-3">
                                    <label asp-for="WidthCm" class="form-label">Width (cm)</label>
                                    <input asp-for="WidthCm" type="number" step="0.1" min="1" max="50" class="form-control" placeholder="0.0" />
                                    <small class="text-muted fw-bold">Max 50 cm</small>
                                    <span asp-validation-for="WidthCm" class="text-danger small d-block"></span>
                                </div>
                                <div class="col-md-3">
                                    <label asp-for="HeightCm" class="form-label">Height (cm)</label>
                                    <input asp-for="HeightCm" type="number" step="0.1" min="1" max="50" class="form-control" placeholder="0.0" />
                                    <small class="text-muted fw-bold">Max 50 cm</small>
                                    <span asp-validation-for="HeightCm" class="text-danger small d-block"></span>
                                </div>
                            </div>
                        </div>

                        <div class="d-grid">
                            <button type="submit" class="btn btn-success btn-lg fw-bold">Request Now</button>
                        </div>
                    </form>

                    <div asp-validation-summary="All" class="text-danger fw-bold mb-3"></div>

                   

                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
    <script src="https://unpkg.com/leaflet-routing-machine@latest/dist/leaflet-routing-machine.js"></script>

    <script>
        // --- 3. RESTORED PACKAGE TOGGLE LOGIC ---
        const typeSelect = document.getElementById('deliveryTypeSelect');
        const packageSection = document.getElementById('packageDetailsSection');
        function togglePackageSection() {
            packageSection.style.display = typeSelect.value === 'Package' ? 'block' : 'none';
        }
        typeSelect.addEventListener('change', togglePackageSection);
        togglePackageSection();

        // --- MAP INITIALIZATION ---
        var map = L.map('map').setView([30.0444, 31.2357], 13);

        L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
            maxZoom: 19,
            attribution: '&copy; OpenStreetMap contributors'
        }).addTo(map);

        // --- AUTOMATICALLY FIND USER'S CURRENT LOCATION ---
        if (navigator.geolocation) {
            navigator.geolocation.getCurrentPosition(function(position) {
                var userLat = position.coords.latitude;
                var userLng = position.coords.longitude;
                map.setView([userLat, userLng], 15);

                L.circleMarker([userLat, userLng], { color: '#007bff', radius: 8, fillOpacity: 0.8 }).addTo(map).bindPopup("You are here");
            });
        }

        var pickupMarker = null;
        var destinationMarker = null;
        var pickupCity = "";
        var routingControl = null;

        var greenIcon = new L.Icon({ iconUrl: 'https://raw.githubusercontent.com/pointhi/leaflet-color-markers/master/img/marker-icon-2x-green.png', shadowUrl: 'https://cdnjs.cloudflare.com/ajax/libs/leaflet/0.7.7/images/marker-shadow.png', iconSize: [25, 41], iconAnchor: [12, 41] });
        var redIcon = new L.Icon({ iconUrl: 'https://raw.githubusercontent.com/pointhi/leaflet-color-markers/master/img/marker-icon-2x-red.png', shadowUrl: 'https://cdnjs.cloudflare.com/ajax/libs/leaflet/0.7.7/images/marker-shadow.png', iconSize: [25, 41], iconAnchor: [12, 41] });

        // --- FETCH DETAILED ADDRESS & CITY DATA ---
        async function getLocationData(lat, lng) {
            try {
                let response = await fetch(`https://nominatim.openstreetmap.org/reverse?format=jsonv2&lat=${lat}&lon=${lng}&addressdetails=1`);
                let data = await response.json();
                let city = data.address.city || data.address.state || data.address.county || data.address.town || "Unknown Region";
                return { address: data.display_name, city: city };
            } catch (error) {
                return null;
            }
        }

        // --- MAP CLICK LOGIC ---
        map.on('click', async function(e) {
            var lat = e.latlng.lat;
            var lng = e.latlng.lng;

            // 1st Click: Set Pickup
            if (pickupMarker == null) {
                pickupMarker = L.marker([lat, lng], {icon: greenIcon}).addTo(map).bindPopup("<b>Pickup</b>").openPopup();
                document.getElementById('PickupAddress').value = "Fetching address...";
                document.getElementById('resetMapBtn').style.display = 'inline-block';

                let locationData = await getLocationData(lat, lng);
                if(locationData) {
                    document.getElementById('PickupAddress').value = locationData.address;
                    pickupCity = locationData.city;
                }
            }
            // 2nd Click: Set Destination
            else if (destinationMarker == null) {
                document.getElementById('DestinationAddress').value = "Checking location...";

                let locationData = await getLocationData(lat, lng);

                // GEOFENCING CHECK
                if (locationData && locationData.city !== pickupCity) {
                    alert(`Sorry! This app only supports rides within the same region.\nPickup: ${pickupCity}\nDestination: ${locationData.city}`);
                    document.getElementById('DestinationAddress').value = "";
                    return;
                }

                destinationMarker = L.marker([lat, lng], {icon: redIcon}).addTo(map).bindPopup("<b>Destination</b>").openPopup();
                document.getElementById('DestinationAddress').value = locationData.address;

                // LEAFLET ROUTING MACHINE
                routingControl = L.Routing.control({
                    waypoints: [
                        pickupMarker.getLatLng(),
                        destinationMarker.getLatLng()
                    ],
                    routeWhileDragging: false,
                    addWaypoints: false,
                    show: false,
                    createMarker: function() { return null; }
                }).on('routesfound', function(e) {
                    var routes = e.routes;
                    var summary = routes[0].summary;
                    var distanceKm = (summary.totalDistance / 1000).toFixed(2);

                    document.getElementById('distanceDisplay').innerHTML = `<strong class="text-success">Road Driving Distance: ${distanceKm} km</strong>`;
                    document.getElementById('DistanceKm').value = distanceKm;

                }).addTo(map);
            }
        });

        // --- RESET BUTTON ---
        document.getElementById('resetMapBtn').addEventListener('click', function() {
            if(pickupMarker) map.removeLayer(pickupMarker);
            if(destinationMarker) map.removeLayer(destinationMarker);

            if(routingControl) {
                map.removeControl(routingControl);
                routingControl = null;
            }

            pickupMarker = null;
            destinationMarker = null;
            pickupCity = "";
            document.getElementById('PickupAddress').value = "";
            document.getElementById('DestinationAddress').value = "";
            document.getElementById('DistanceKm').value = "";
            document.getElementById('distanceDisplay').innerHTML = "";
            this.style.display = 'none';
        });
    </script>
}