@model DeliveryApp.Models.Ride

@{
    ViewData["Title"] = "Request a New Ride";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-header bg-success text-white">
                    <h4 class="mb-0">Create New Delivery Request</h4>
                </div>
                <div class="card-body">
                    <form asp-action="RequestRide" method="post">
                        @* Validation summary to show any logic errors *@
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <div class="form-group mb-3">
                            <label asp-for="PickupAddress" class="form-label fw-bold">Pickup Location</label>
                            <input asp-for="PickupAddress" class="form-control" placeholder="Enter pickup address" required />
                            <span asp-validation-for="PickupAddress" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="DestinationAddress" class="form-label fw-bold">Destination Location</label>
                            <input asp-for="DestinationAddress" class="form-control" placeholder="Enter destination address" required />
                            <span asp-validation-for="DestinationAddress" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="DeliveryType" class="form-label fw-bold">Service Type</label>
                            <select asp-for="DeliveryType" class="form-select" id="typeSelect">
                                <option value="Passenger">🚗 Passenger Transport</option>
                                <option value="Package">📦 Package Delivery</option>
                            </select>
                        </div>

                        @* This field only shows if the type is "Package" *@
                        <div class="form-group mb-3" id="packageField" style="display:none;">
                            <label asp-for="PackageDescription" class="form-label fw-bold">Package Details</label>
                            <textarea asp-for="PackageDescription" class="form-control" rows="2" placeholder="What are we delivering?"></textarea>
                        </div>

                        <div class="form-group mb-4">
                            <label asp-for="Price" class="form-label fw-bold">Offered Price ($)</label>
                            <input asp-for="Price" type="number" step="0.01" class="form-control" placeholder="0.00" required />
                            <span asp-validation-for="Price" class="text-danger"></span>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-success btn-lg">Submit Request</button>
                            <a asp-action="Index" class="btn btn-outline-secondary">Back to Dashboard</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    
    <script>
        // Simple logic to toggle package description field
        document.getElementById('typeSelect').addEventListener('change', function () {
            var packageDiv = document.getElementById('packageField');
            packageDiv.style.display = this.value === 'Package' ? 'block' : 'none';
        });
    </script>
}