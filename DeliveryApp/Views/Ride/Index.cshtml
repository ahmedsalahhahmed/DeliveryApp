@model IEnumerable<DeliveryApp.Models.Ride>
@using Microsoft.AspNetCore.Identity
@using DeliveryApp.Models
@inject UserManager<AppUser> UserManager

@{
    ViewData["Title"] = "Dashboard";
    var currentUser = await UserManager.GetUserAsync(User);

    ViewData["CurrentUser"] = currentUser;

    var passengerRides = new List<Ride>();
    var activeDriverJobs = new List<Ride>();
    var availableJobs = new List<Ride>();

    // NEW: A list to hold the driver's past trips!
    var completedDriverJobs = new List<Ride>();

    if (currentUser?.UserType == "Passenger")
    {
        passengerRides = Model.Where(r => r.PassengerId == currentUser.Id).OrderByDescending(r => r.Id).ToList();
    }
    else if (currentUser?.UserType == "Driver")
    {
        activeDriverJobs = Model.Where(r => r.DriverId == currentUser.Id && r.Status == "Driver Assigned").ToList();
        availableJobs = Model.Where(r => r.Status == "Requested").OrderByDescending(r => r.Id).ToList();

        
        completedDriverJobs = Model.Where(r => r.DriverId == currentUser.Id && r.Status == "Completed").OrderByDescending(r => r.Id).ToList();
    }
}

<div class="container mt-5">

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger shadow-sm border-danger border-2 text-center mb-4">
            <strong>❌ Error:</strong> @TempData["ErrorMessage"]
        </div>
    }

    @if (currentUser?.UserType == "Driver" && ViewBag.HasVehicle == false)
    {
        <div class="alert alert-danger shadow-sm border-danger border-2 text-center mb-4">
            <h4 class="alert-heading fw-bold">⚠️ Action Required</h4>
            <p>You cannot accept rides or view job details until you register a vehicle.</p>
            <hr>
            <a asp-controller="Vehicle" asp-action="RegisterCar" class="btn btn-danger fw-bold">Register Your Vehicle Now</a>
        </div>
    }

    @* Passenger View *@
    @if (currentUser?.UserType == "Passenger")
    {
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h2>My Rides</h2>
            @if (!passengerRides.Any(r => r.Status != "Completed" && r.Status != "Cancelled"))
            {
                <a asp-action="RequestRide" class="btn btn-success">+ Request New Ride</a>
            }
        </div>

        <div class="table-responsive">
            <partial name="_RideTablePartial" model="passengerRides" view-data="ViewData" />
        </div>
    }

    @* Driver View *@
    @if (currentUser?.UserType == "Driver")
    {
        //Reputation Card
        <div class="row mb-4 mt-2">
            <div class="col-md-5">
                <div class="card shadow-sm border-warning">
                    <div class="card-body d-flex align-items-center">
                        <h1 class="display-4 mb-0 me-3">⭐</h1>
                        <div>
                            <h5 class="card-title text-muted fw-bold mb-0">My Reputation</h5>
                            @if (ViewBag.TotalReviews > 0)
                            {
                                <h2 class="fw-bold mb-0 text-dark">
                                    @(((double)ViewBag.AverageRating).ToString("0.0"))
                                    <span class="fs-6 text-muted fw-normal">(@ViewBag.TotalReviews reviews)</span>
                                </h2>
                            }
                            else
                            {
                                <h4 class="text-muted fst-italic mb-0 mt-1">No reviews yet</h4>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>

        // My Active Job
        @if (activeDriverJobs.Any())
        {
            <div class="card border-success mb-5 shadow-sm">
                <div class="card-header bg-success text-white fw-bold">
                    <h4 class="mb-0">📍 My Active Job</h4>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive mb-0">
                        <partial name="_RideTablePartial" model="activeDriverJobs" view-data="ViewData" />
                    </div>
                </div>
            </div>
        }

        // Available Jobs Board
        <div class="d-flex justify-content-between align-items-center mb-3 mt-4">
            <h2>🌍 Available Jobs Board</h2>
            <span class="badge bg-primary fs-6">@availableJobs.Count Open Jobs</span>
        </div>
        <div class="table-responsive shadow-sm border rounded mb-5">
            <partial name="_RideTablePartial" model="availableJobs" view-data="ViewData" />
        </div>

        // ==========================================
        // SECTION 3: NEW TRIP HISTORY SECTION!
        // ==========================================
        @if (completedDriverJobs.Any())
        {
            <div class="d-flex justify-content-between align-items-center mb-3 mt-5">
                <h3 class="text-muted">✅ Trip History</h3>
                <span class="badge bg-secondary fs-6">@completedDriverJobs.Count Completed</span>
            </div>

            <div class="table-responsive shadow-sm border rounded opacity-75">
                <partial name="_RideTablePartial" model="completedDriverJobs" view-data="ViewData" />
            </div>
        }
    }

</div>