@model IEnumerable<DeliveryApp.Models.Ride>

@{
    ViewData["Title"] = "Ride Dashboard";
}

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Ride & Delivery Dashboard</h2>
        <a asp-action="RequestRide" class="btn btn-success">+ New Request</a>
    </div>

    <table class="table table-hover table-bordered">
        <thead class="table-dark">
            <tr>
                <th>Type</th>
                <th>Pickup</th>
                <th>Destination</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            @if (item.DeliveryType == "Package")
                            {
                                <span class="badge bg-info text-dark">📦 Package</span>
                            }
                            else
                            {
                                <span class="badge bg-primary">🚗 Passenger</span>
                            }
                        </td>
                        <td>@item.PickupAddress</td>
                        <td>@item.DestinationAddress</td>
                        <td>
                            <span class="badge bg-warning text-dark">@item.Status</span>
                        </td>

                        <td>
                            @if (item.Status == "Requested")
                            {
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Cancel</a>
                            }
                            else
                            {
                                <span class="text-muted small">Ride in progress</span>
                            }
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="5" class="text-center">No rides requested yet.</td>
                </tr>
            }
        </tbody>
    </table>
</div>