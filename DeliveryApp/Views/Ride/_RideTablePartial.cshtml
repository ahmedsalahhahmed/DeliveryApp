@model IEnumerable<DeliveryApp.Models.Ride>
@using DeliveryApp.Models
@using DeliveryApp.Data
@inject ApplicationDbContext Context

@{
    // Safely grab the variables passed down from the main Index view
    var currentUser = ViewData["CurrentUser"] as AppUser;
    bool hasVehicle = ViewBag.HasVehicle ?? false;
    bool isBusy = ViewBag.IsBusy ?? false;
}

<table class="table table-hover table-bordered mb-0 align-middle">
    <thead class="table-dark">
        <tr>
            <th>Type</th>
            <th>Route Details</th>
            <th class="text-center">Pay / Distance</th>
            <th class="text-center">Status</th>
            @if (currentUser?.UserType == "Passenger")
            {
                <th>Driver Details</th>
            }
            <th class="text-center">Actions</th>
        </tr>
    </thead>
    <tbody class="bg-white">
        @if (!Model.Any())
        {
            <tr>
                <td colspan="6" class="text-center text-muted p-4">
                    <em>No rides found in this category.</em>
                </td>
            </tr>
        }
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    <span class="fs-5">@(item.DeliveryType == "Package" ? "📦" : "🚗")</span><br />
                    <small class="text-muted fw-bold">@item.DeliveryType</small>
                </td>
                <td>
                    <strong class="text-success">From:</strong> @item.PickupAddress <br />
                    <strong class="text-danger">To:</strong> @item.DestinationAddress

                    @if (item.DeliveryType == "Package")
                    {
                        <div class="mt-2 p-2 bg-light border rounded small shadow-sm">
                            <strong class="text-dark">📦 Item:</strong> @(string.IsNullOrEmpty(item.PackageDescription) ? "No description provided" : item.PackageDescription) <br />
                            <span class="text-muted fw-bold">
                                ⚖️ @item.EstimatedWeightKg kg | 📏 @item.LengthCm x @item.WidthCm x @item.HeightCm cm
                            </span>
                        </div>
                    }
                </td>

                <td class="text-center">
                    <h5 class="text-success fw-bold mb-0">$@item.Price.ToString("0.00")</h5>
                    <small class="text-muted">@item.DistanceKm km total</small>
                </td>

                <td class="text-center">
                    <span class="badge bg-warning text-dark px-3 py-2">@item.Status</span>
                </td>

                @if (currentUser?.UserType == "Passenger")
                {
                    <td>
                        @if (item.DriverId != null && item.Driver != null)
                        {
                            <div class="d-flex align-items-center">
                                @if (!string.IsNullOrEmpty(item.Driver.ProfileImagePath))
                                {
                                    <img src="@item.Driver.ProfileImagePath" class="rounded-circle me-3 shadow-sm" style="width: 45px; height: 45px; object-fit: cover; border: 2px solid #ddd;" alt="Driver Photo" />
                                }
                                else
                                {
                                    <div class="bg-secondary rounded-circle me-3 d-flex justify-content-center align-items-center text-white shadow-sm" style="width: 45px; height: 45px;">
                                        <span>👤</span>
                                    </div>
                                }
                                <div>
                                    <strong class="mb-0">@item.Driver.Name</strong><br />
                                    <span class="text-muted small">
                                        @item.Driver.DriverVehicle?.Make @item.Driver.DriverVehicle?.Model <br />
                                        Plate: <strong class="text-dark">@item.Driver.DriverVehicle?.LicensePlate</strong>
                                    </span>
                                </div>
                            </div>
                        }
                        else
                        {
                            <span class="text-muted fst-italic">Waiting for driver...</span>
                        }
                    </td>
                }
                <td class="text-center">
                    @if (currentUser?.UserType == "Passenger" && item.Status == "Requested")
                    {
                        var offerCount = Context.RideOffers.Count(o => o.RideId == item.Id);
                        <a asp-action="ViewOffers" asp-route-rideId="@item.Id" class="btn btn-sm btn-primary fw-bold w-100 mb-1">
                            View Offers (@offerCount)
                        </a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger w-100">Cancel</a>
                    }

                    @if (currentUser?.UserType == "Passenger" && item.Status == "Completed" && item.DriverRating == null)
                    {
                        <a asp-action="RateDriver" asp-route-id="@item.Id" class="btn btn-warning fw-bold w-100 shadow-sm text-dark">
                            ⭐ Rate Driver
                        </a>
                    }
                    else if (currentUser?.UserType == "Passenger" && item.DriverRating != null)
                    {
                        <span class="badge bg-light text-dark border w-100 py-2">You rated: @item.DriverRating ⭐</span>
                    }

                    @if (currentUser?.UserType == "Driver")
                    {
                        if (item.Status == "Requested" && item.DriverId == null)
                        {
                            var alreadyOffered = Context.RideOffers.Any(o => o.RideId == item.Id && o.DriverId == currentUser.Id);
                            if (alreadyOffered)
                            {
                                <span class="badge bg-secondary w-100 py-2">Offer Sent</span>
                            }
                            else if (isBusy)
                            {
                                <span class="badge bg-danger w-100 py-2 shadow-sm">Finish trip to bid</span>
                            }
                            else if (hasVehicle)
                            {
                                <button type="button" class="btn btn-sm btn-success fw-bold w-100" data-bs-toggle="modal" data-bs-target="#offerModal-@item.Id">
                                    Offer to Drive
                                </button>

                                <div class="modal fade" id="offerModal-@item.Id" tabindex="-1" aria-hidden="true">
                                    <div class="modal-dialog modal-dialog-centered">
                                        <div class="modal-content">
                                            <div class="modal-header bg-success text-white">
                                                <h5 class="modal-title fw-bold">Submit Your Bid</h5>
                                                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                                            </div>
                                            <form asp-action="MakeOffer" method="post">
                                                <div class="modal-body text-start">
                                                    @{
                                                        var maxAllowedPrice = Math.Round(item.Price * 1.20m, 2);
                                                    }
                                                    <div class="alert alert-info">
                                                        Suggested Base Price: <strong>$@item.Price.ToString("0.00")</strong><br />
                                                        <span class="text-danger fw-bold">Allowed Range: $@item.Price.ToString("0.00") - $@maxAllowedPrice.ToString("0.00")</span><br />
                                                        <small>Distance: @item.DistanceKm km</small>
                                                    </div>
                                                    <input type="hidden" name="rideId" value="@item.Id" />
                                                    <div class="mb-3">
                                                        <label class="form-label fw-bold">Your Offer ($)</label>
                                                        <input type="number" step="0.01" min="@item.Price" max="@maxAllowedPrice" name="offeredPrice" class="form-control form-control-lg text-success fw-bold" value="@item.Price" required />
                                                    </div>
                                                </div>
                                                <div class="modal-footer">
                                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                                    <button type="submit" class="btn btn-success fw-bold">Submit Bid</button>
                                                </div>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                        else if (item.Status == "Driver Assigned" && item.DriverId == currentUser.Id)
                        {
                            <form asp-action="CompleteRide" method="post" class="d-inline">
                                <input type="hidden" name="rideId" value="@item.Id" />
                                <button type="submit" class="btn btn-dark fw-bold w-100 py-2 shadow-sm">Mark as Completed</button>
                            </form>
                        }
                        else if (item.Status == "Completed" && item.DriverId == currentUser.Id)
                        {
                            if (item.DriverRating != null)
                            {
                                <div class="p-2 border border-warning rounded bg-light mt-2 text-start shadow-sm">
                                    <span class="badge bg-warning text-dark fs-6 w-100 mb-1">You earned: @item.DriverRating ⭐</span>
                                    @if (!string.IsNullOrEmpty(item.DriverReview))
                                    {
                                        <small class="fst-italic text-muted d-block mt-1">"@item.DriverReview"</small>
                                    }
                                </div>
                            }
                            else
                            {
                                <span class="badge bg-secondary text-white w-100 py-2 mt-2">Waiting for passenger to rate...</span>
                            }
                        }
                    }
                </td>
            </tr>
        }
    </tbody>
</table>