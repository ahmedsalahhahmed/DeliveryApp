@model IEnumerable<DeliveryApp.Models.Ride>

@{
    ViewData["Title"] = "Available Rides";
}

<div class="container mt-4">
    <h2 class="mb-4">Available Delivery Requests</h2>

    @if (!Model.Any())
    {
        <div class="alert alert-info">No pending rides available at the moment.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover border">
                <thead class="table-dark">
                    <tr>
                        <th>Customer</th>
                        <th>From</th>
                        <th>To</th>
                        <th>Type</th>
                        <th>Price</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Passenger.Name</td>
                            <td>@item.PickupAddress</td>
                            <td>@item.DestinationAddress</td>
                            <td>
                                <span class="badge @(item.DeliveryType == "Package" ? "bg-warning" : "bg-info")">
                                    @item.DeliveryType
                                </span>
                            </td>
                            <td>@item.Price.ToString("C")</td>
                            <td>
                                <form asp-action="AcceptRide" asp-route-id="@item.Id" method="post">
                                    <button type="submit" class="btn btn-success btn-sm">Accept Ride</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>