@model DeliveryApp.Models.Ride
@{
    ViewData["Title"] = "Edit Request";
}

<div class="container mt-5">
    <h2>Edit Ride/Delivery Request</h2>
    <hr />
    <div class="row">
        <div class="col-md-6">
            <form asp-action="Edit" method="post">
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="DeliveryType" />
                <input type="hidden" asp-for="Status" />
                <input type="hidden" asp-for="Price" />

                <div class="mb-3">
                    <label asp-for="PickupAddress" class="control-label">Pickup</label>
                    <input asp-for="PickupAddress" class="form-control" />
                </div>
                <div class="mb-3">
                    <label asp-for="DestinationAddress" class="control-label">Destination</label>
                    <input asp-for="DestinationAddress" class="form-control" />
                </div>

                @if (Model.DeliveryType == "Package")
                {
                    <div class="alert alert-secondary">
                        <h4>Package Details</h4>
                        <div class="mb-2">
                            <label asp-for="PackageDescription" class="control-label">Description</label>
                            <input asp-for="PackageDescription" class="form-control" />
                        </div>
                        <div class="mb-2">
                            <label asp-for="EstimatedWeightKg" class="control-label">Weight (kg)</label>
                            <input asp-for="EstimatedWeightKg" class="form-control" />
                        </div>
                    </div>
                }

                <button type="submit" class="btn btn-primary">Save Changes</button>
                <a asp-action="Index" class="btn btn-secondary">Cancel</a>
            </form>
        </div>
    </div>
</div>